# Copy to .env (never commit .env). Values below are DEMO placeholders only.
APP_ENV=development
# Generate a real key for anything beyond local demo:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me
ACCESS_TOKEN_MINUTES=60
# SQLite by default. PostgreSQL example: postgresql+psycopg2://user:pass@localhost:5432/saathi
DATABASE_URL=sqlite:///./saathi.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RETENTION_FREE_TEXT_DAYS=365
ANALYTICS_MIN_CELL=3

# Demo seed credentials (synthetic accounts only). Choose your own; they are read by `python -m scripts.seed`.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe-Admin-1
SEED_CASEWORKER_PASSWORD=ChangeMe-Worker-1
SEED_BENEFICIARY_PASSWORD=ChangeMe-Benef-1

DEMO_MODE=true
